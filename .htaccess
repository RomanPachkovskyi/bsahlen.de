# =============================================================================
# Studio Standard .htaccess (Monorepo Router)
# =============================================================================

RewriteEngine On

# ----- Force HTTPS (production) -----
# Uncomment on production:
# RewriteCond %{HTTPS} off
# RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# ----- Map legacy WP paths to /wp (monorepo structure) -----
RewriteRule ^wp-content/(.*)$ /wp/wp-content/$1 [L,NC]
RewriteRule ^wp-includes/(.*)$ /wp/wp-includes/$1 [L,NC]
RewriteRule ^wp-admin/(.*)$ /wp/wp-admin/$1 [L,NC]
RewriteRule ^wp-login\.php$ /wp/wp-login.php [L,NC]

# ----- Serve existing files/directories directly -----
# Static assets in /maintenance and /wp are served as-is
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# ----- Everything else → Router -----
RewriteRule ^ index.php [L]
