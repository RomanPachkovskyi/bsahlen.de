# WordPress core
wp/wp-admin/
wp/wp-includes/
wp/wp-*.php
wp/index.php
wp/license.txt
wp/readme.html
wp/xmlrpc.php

# Uploads (sync via WordMove)
wp/wp-content/uploads/

# Cache & temp
wp/wp-content/cache/
wp/wp-content/upgrade/
wp/wp-content/wflogs/
*.log

# Local config
wp/wp-config.php
.DS_Store
.env

# Database dumps & backups
backups/
backups/*.sql
backups/*.sql.gz

# Theme samples (remove secrets)
wp/wp-content/themes/finovate/samples/instagram-feed.json

# Language files (auto-downloaded by WordPress)
wp/wp-content/languages/

# 3rd party plugins (not in Git, only custom plugins)
wp/wp-content/plugins/duplicate-post/
wp/wp-content/plugins/elementor/
wp/wp-content/plugins/elementor-pro/
wp/wp-content/plugins/lasoon-maintenance/
wp/wp-content/plugins/redis-cache/
wp/wp-content/plugins/svg-support/
wp/wp-content/plugins/vamtam-elementor-integration-finovate/
wp/wp-content/plugins/vamtam-importers-e/
wp/wp-content/plugins/wordpress-seo/

# Redis drop-in
wp/wp-content/object-cache.php

# Keep only custom plugins (custom-* pattern)
# Example: wp/wp-content/plugins/custom-myplugin/

# Backup files
.env.backup
*.backup

# Archive folder
docs/archive/

# Workspace (temporary files for AI/owner exchange)
workspace/

# Hosting logs (keep folder, ignore contents)
logs/*
!logs/.gitkeep

# ========================================
# Technical documentation (not for production)
# ========================================
/PROJECT.md
/README.md
/SOP.md
/SERVER_RULES.md
/docs/
/logs/

# ========================================
# Development files (not for production)
# ========================================
/docker-compose.yml
/wp-config-local.php
/php.ini

# ========================================
# Technical notes & maintenance
# ========================================
/maintenance/

# Ignore .txt files in wp/ directory (except explicitly allowed ones)
wp/*.txt
!wp/robots.txt

# AI & SEO context files in root (KEEP THESE)
# These files are important for search engines and AI crawlers
!/robots.txt
!/lIms.txt

# ========================================
# Production configs (security - keep out of git)
# ========================================
/wp-config-production.php

